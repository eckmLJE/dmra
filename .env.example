# Deployment target. Both are optional: with neither set, the site builds for
# http://localhost:4321 at the domain root, which is what you want locally.
#
# CI sets these automatically from the GitHub Pages configuration, so there is
# nothing to edit when the Pages URL changes. Set them by hand only when
# building for some other host.

# Origin the site will be served from, used for canonical and social URLs.
# SITE_URL="https://example.com"

# Subdirectory the site is served from, with a leading slash and no trailing
# slash. Leave unset when the site lives at the domain root.
# BASE_PATH="/dmra"
