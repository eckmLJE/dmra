---
import { NAV_LINKS, url } from '../consts';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page not found"
  description="That page does not exist. Links to the rest of the site."
>
  <div class="mx-auto max-w-5xl px-6 py-20">
    <p class="text-brand-700 text-sm font-semibold tracking-wide uppercase">
      404
    </p>
    <h1
      class="mt-3 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl"
    >
      We couldn't find that page
    </h1>
    <p class="mt-4 max-w-xl text-lg text-slate-600">
      The link may be out of date, or the address may have a typo in it. Here is
      everything on the site:
    </p>

    <ul class="mt-8 grid gap-3 sm:max-w-md">
      {
        NAV_LINKS.map((link) => (
          <li>
            <a
              href={url(link.href)}
              class="hover:border-brand-600 hover:text-brand-700 block rounded-lg border border-slate-200 px-4 py-3 font-medium text-slate-700"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>
