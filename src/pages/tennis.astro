---
import FacilityDetail from '../components/FacilityDetail.astro';
import { FACILITIES } from '../consts';
import BaseLayout from '../layouts/BaseLayout.astro';
import { photosFor } from '../photos';

const facility = FACILITIES.find((f) => f.sport === 'Tennis');
if (facility === undefined)
  throw new Error('Missing tennis facility in consts.ts');
---

<BaseLayout
  title="Tennis"
  description="Two well-sheltered outdoor hard courts on Widgeon Drive in Eastham, Massachusetts."
>
  <FacilityDetail facility={facility} photos={photosFor('tennis')} />
</BaseLayout>
