---
import { MAILING_ADDRESS, ORG_NAME, SITE_TITLE } from '../consts';

const year = new Date().getFullYear();
---

<footer class="mt-20 border-t border-slate-200 bg-slate-50">
  <div
    class="mx-auto max-w-5xl px-6 py-10 text-sm text-slate-500 sm:flex sm:items-start sm:justify-between"
  >
    <div>
      <p class="font-medium text-slate-700">{SITE_TITLE}</p>
      <address class="mt-1 not-italic">
        {
          MAILING_ADDRESS.map((line, i) => (
            <Fragment>
              {i > 0 && <br />}
              {line}
            </Fragment>
          ))
        }
      </address>
    </div>
    <p class="mt-4 sm:mt-0 sm:text-right">
      {`© ${year} ${ORG_NAME}.`}
    </p>
  </div>
</footer>
