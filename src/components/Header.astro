---
import { NAV_LINKS, SITE_TITLE, url } from '../consts';

const { pathname } = Astro.url;

// Compare against the prefixed href: at runtime `pathname` includes the base.
const isCurrent = (href: string): boolean =>
  href === '/' ? pathname === url('/') : pathname.startsWith(url(href));
---

<header class="border-b border-slate-200 bg-white">
  <div
    class="mx-auto flex max-w-5xl flex-col gap-3 px-6 py-4 sm:flex-row sm:items-center sm:justify-between"
  >
    <a
      href={url('/')}
      class="text-brand-700 hover:text-brand-900 text-lg font-semibold tracking-tight"
    >
      {SITE_TITLE}
    </a>
    <nav aria-label="Main">
      <ul
        class="flex flex-wrap items-center gap-x-5 gap-y-1 text-sm font-medium"
      >
        {
          NAV_LINKS.map((link) => (
            <li>
              <a
                href={url(link.href)}
                aria-current={isCurrent(link.href) ? 'page' : undefined}
                class="hover:text-brand-700 aria-[current=page]:text-brand-700 text-slate-600 aria-[current=page]:underline aria-[current=page]:underline-offset-4"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
