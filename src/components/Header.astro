---
import { NAV_LINKS, SITE_TITLE } from '../consts';

const { pathname } = Astro.url;

const isCurrent = (href: string): boolean =>
  href === '/' ? pathname === '/' : pathname.startsWith(href);
---

<header class="border-b border-slate-200 bg-white">
  <div
    class="mx-auto flex max-w-4xl items-center justify-between gap-4 px-6 py-4"
  >
    <a
      href="/"
      class="text-brand-700 hover:text-brand-900 text-lg font-semibold tracking-tight"
    >
      {SITE_TITLE}
    </a>
    <nav aria-label="Main">
      <ul class="flex items-center gap-6 text-sm font-medium">
        {
          NAV_LINKS.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={isCurrent(link.href) ? 'page' : undefined}
                class="hover:text-brand-700 aria-[current=page]:text-brand-700 text-slate-600"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
