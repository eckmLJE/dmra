---
import type { Facility } from '../consts';
import { mapsUrl } from '../consts';
import type { Photo } from '../photos';
import PhotoGrid from './PhotoGrid.astro';

interface Props {
  facility: Facility;
  photos: readonly Photo[];
}

const { facility, photos } = Astro.props;
---

<div class="mx-auto max-w-5xl px-6 py-12">
  <p class="text-brand-700 text-sm font-semibold tracking-wide uppercase">
    {facility.sport}
  </p>
  <h1 class="mt-2 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
    {facility.name}
  </h1>
  <p class="mt-3 text-lg text-slate-600">
    {facility.courts} &middot;{' '}
    <a
      href={mapsUrl(facility.address)}
      class="hover:text-brand-700 underline underline-offset-4"
      rel="noopener"
    >
      {facility.address}
    </a>
  </p>

  <ul class="mt-8 grid gap-3 sm:grid-cols-2">
    {
      facility.features.map((feature) => (
        <li class="flex gap-3 rounded-lg border border-slate-200 bg-white p-4 text-slate-700">
          <span class="text-brand-600 mt-0.5 shrink-0" aria-hidden="true">
            &#10003;
          </span>
          <span>{feature}</span>
        </li>
      ))
    }
  </ul>

  {
    photos.length > 0 && (
      <section class="mt-14">
        <h2 class="text-xl font-semibold text-slate-900">Photos</h2>
        <div class="mt-5">
          <PhotoGrid photos={photos} />
        </div>
      </section>
    )
  }

  <p class="bg-brand-50 mt-14 rounded-lg p-6 text-slate-700">
    The courts are open to association members and their guests.{' '}
    <a
      href="/membership/"
      class="text-brand-700 font-semibold underline underline-offset-4"
    >
      Join us &rarr;
    </a>
  </p>
</div>
