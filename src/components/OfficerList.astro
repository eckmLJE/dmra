---
import { OFFICERS } from '../consts';

// Strip formatting so the number is dialable from a phone.
const telHref = (phone: string): string => `tel:+1${phone.replace(/\D/g, '')}`;
---

<ul class="grid gap-4 sm:grid-cols-3">
  {
    OFFICERS.map((officer) => (
      <li class="rounded-lg border border-slate-200 bg-white p-4">
        <p class="font-semibold text-slate-900">{officer.name}</p>
        <p class="text-brand-700 text-sm font-medium">{officer.role}</p>
        <p class="mt-3 text-sm break-words">
          <a
            href={`mailto:${officer.email}`}
            class="hover:text-brand-700 text-slate-600 underline underline-offset-4"
          >
            {officer.email}
          </a>
        </p>
        <p class="text-sm">
          <a
            href={telHref(officer.phone)}
            class="hover:text-brand-700 text-slate-600"
          >
            {officer.phone}
          </a>
        </p>
      </li>
    ))
  }
</ul>
