---
import { CONTACT_EMAIL, OFFICERS } from '../consts';
---

<div class="text-sm text-slate-600">
  <ul class="flex flex-wrap gap-x-6 gap-y-1">
    {
      OFFICERS.map((officer) => (
        // `flex` drops the whitespace-only text node between the two spans,
        // which would otherwise render as "Name , Role".
        <li class="flex">
          <span class="font-medium text-slate-900">{officer.name}</span>
          <span class="text-slate-500">{`, ${officer.role}`}</span>
        </li>
      ))
    }
  </ul>
  <p class="mt-3">
    Email the association at{' '}
    <a
      href={`mailto:${CONTACT_EMAIL}`}
      class="hover:text-brand-700 text-brand-700 underline underline-offset-4"
    >
      {CONTACT_EMAIL}
    </a>
    {'; it reaches all of them.'}
  </p>
</div>
